{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "canary": {
            "type": "object",
            "properties": {
                "clusters": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "analysisStartingStep": {
                                "type": "integer"
                            },
                            "steps": {
                                "type": "array",
                                "items": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            }
        },
        "consulAgent": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "env": {
            "type": "array"
        },
        "failover": {
            "type": "object",
            "properties": {
                "gracePeriodSeconds": {
                    "type": "integer"
                },
                "tolerationSeconds": {
                    "type": "integer"
                }
            }
        },
        "fullnameOverride": {
            "type": "string"
        },
        "image": {
            "type": "object",
            "properties": {
                "digest": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "karmada": {
            "type": "object",
            "properties": {
                "targetClusters": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "mesh": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "nameOverride": {
            "type": "string"
        },
        "namespace": {
            "type": "string"
        },
        "opa": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "replicas": {
            "type": "integer"
        },
        "resources": {
            "type": "object"
        },
        "rollout": {
            "type": "object",
            "properties": {
                "maxSurge": {
                    "type": "string"
                },
                "maxUnavailable": {
                    "type": "string"
                },
                "revisionHistoryLimit": {
                    "type": "integer"
                },
                "rollbackWindow": {
                    "type": "object",
                    "properties": {
                        "revisions": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "integer"
                }
            }
        },
        "vaultAgent": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        }
    }
}
